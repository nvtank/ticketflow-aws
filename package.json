{
  "name": "tixflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "engines": { "node": ">=24.0.0 <25", "pnpm": ">=10 <11" },
  "scripts": {
    "dev": "pnpm --filter @tixflow/shared build && pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.0"
  }
}
