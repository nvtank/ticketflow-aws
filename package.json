{
  "name": "tixflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @tixflow/shared build && pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @tixflow/shared build && pnpm -r --if-present typecheck && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @tixflow/shared build && pnpm --filter @tixflow/api build && vitest run",
    "test:e2e": "pnpm build && playwright test",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker-compose.yml down",
    "env:setup": "node scripts/setup-env.mjs",
    "db:generate": "pnpm --filter @tixflow/api db:generate",
    "db:migrate": "pnpm --filter @tixflow/api db:migrate",
    "db:seed": "pnpm --filter @tixflow/shared build && pnpm --filter @tixflow/api build && pnpm --filter @tixflow/api db:seed",
    "test:infra:up": "docker compose -f infrastructure/docker-compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f infrastructure/docker-compose.test.yml down",
    "test:db:prepare": "pnpm --filter @tixflow/api test:db:prepare",
    "test:integration": "pnpm --filter @tixflow/shared build && pnpm --filter @tixflow/api build && pnpm --filter @tixflow/api test:integration",
    "test:e2e:auth": "pnpm build && playwright test --config playwright.auth.config.ts",
    "test:e2e:events": "pnpm build && playwright test --config playwright.events.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.0"
  }
}
