{
  "extends": "./packages/config/typescript/base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
