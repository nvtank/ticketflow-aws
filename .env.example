# Local development only. Copy to .env and replace the password before first use.
NODE_ENV=development
POSTGRES_USER=tixflow
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=tixflow
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://tixflow:change-this-local-password@localhost:5432/tixflow
REDIS_URL=redis://localhost:6379
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Browser uses a same-origin Next.js proxy. This value is server-only.
API_INTERNAL_URL=http://localhost:4000
# Run pnpm env:setup to generate a private local secret. Do not use this placeholder.
JWT_SECRET=generate-with-pnpm-env-setup
JWT_ISSUER=tixflow-local
JWT_AUDIENCE=tixflow-web
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=7
SESSION_MAX_DAYS=30
# Development/test seed only; change for your local environment.
DEMO_PASSWORD=TixFlowDemo!2026
