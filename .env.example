# Local development only. Copy to .env and replace the password before first use.
NODE_ENV=development
POSTGRES_USER=tixflow
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=tixflow
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://tixflow:change-this-local-password@localhost:5432/tixflow
REDIS_URL=redis://localhost:6379
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Browser uses a same-origin Next.js proxy. This value is server-only.
API_INTERNAL_URL=http://localhost:4000
# Run pnpm env:setup to generate a private local secret. Do not use this placeholder.
JWT_SECRET=generate-with-pnpm-env-setup
JWT_ISSUER=tixflow-local
JWT_AUDIENCE=tixflow-web
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=7
SESSION_MAX_DAYS=30
# Development/test seed only; change for your local environment.
DEMO_PASSWORD=TixFlowDemo!2026

# Reconciliation scans PostgreSQL; 0 disables the scheduler for isolated tests.
HOLD_RECONCILE_INTERVAL_MS=5000
# Enable for multiple API processes; Redis is never the reservation authority.
SOCKET_REDIS_ADAPTER=false
# Optional browser Socket.IO origin; default is browser hostname on port 4000.
# NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# Payments: disabled until configured. Use payos for real bank payments.
PAYMENT_PROVIDER=disabled
PAYMENT_RETURN_ORIGIN=http://localhost:3000
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Generate a persistent random key (at least 48 characters); required in production.
# Without this, development/test derives a separate ticket key from JWT_SECRET.
TICKET_SIGNING_KEY=generate-with-pnpm-env-setup-ticket
PAYMENT_RECONCILE_INTERVAL_MS=15000

# Redis admission lease and queue lifetime (seconds)
WAITING_ROOM_ADMISSION_SECONDS=600
WAITING_ROOM_QUEUE_SECONDS=1800
